# Copiar a .env y completar; codificar caracteres especiales de la contraseña en la URL.
DATABASE_URL=postgresql://postgres.PROJECT_REF:CONTRASENA@POOLER_HOST:6543/postgres?sslmode=require
SECRET_KEY=
ADMIN_USER=
# Preferir un hash generado con werkzeug; el valor entre comillas preserva los caracteres $.
ADMIN_PASSWORD_HASH=
# Alternativa local; no definirla si se utiliza ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD=
# En Render debe ser true; para HTTP local usar false.
SESSION_COOKIE_SECURE=false
DB_POOL_MAX=5
